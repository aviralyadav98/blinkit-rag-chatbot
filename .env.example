# Copy this file to .env and fill in real values. Never commit .env.

# Groq API — synthesis + theme/sentiment labeling
GROQ_API_KEY=

# Reddit — free "script" app at reddit.com/prefs/apps (read-only, no username/password needed)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=blinkit-rag-chatbot/0.1 (research script)

# Apify — fallback ingestion path only (Play Store, App Store, Reddit, web crawl actors);
# not required for the free-tier ingestion path (ingestion/run_ingestion.py)
APIFY_TOKEN=

# Vector store — Chroma only (local, free, self-hosted)
CHROMA_PERSIST_DIR=./rag/chroma_data

# Embeddings — BAAI/bge-m3 via sentence-transformers, runs locally, no API key

# Structured store for theme x frequency x source reporting
SQLITE_DB_PATH=./processing/insights.db

# n8n (if self-hosted separately)
N8N_WEBHOOK_BASE_URL=

# Google Docs report publishing (Phase 9, optional) — publishes the validated
# report to a Google Doc on each refresh. Free; personal Gmail works via OAuth.
# Setup: Google Cloud Console -> enable Drive API -> OAuth consent screen set to
# "Production" (NOT "Testing" — Testing refresh tokens die after 7 days) -> create
# a "Desktop app" OAuth client -> download JSON -> point the var below at it, then
# run `app/gdoc_auth.py` once. Both files below are secrets — never commit them.
GOOGLE_OAUTH_CLIENT_SECRETS=./app/client_secret.json
GDOC_TOKEN_PATH=./app/.gdoc_token.json
# Email the published Doc is auto-shared to (writer). Leave blank to skip sharing.
GDOC_SHARE_EMAIL=
